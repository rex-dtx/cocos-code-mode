# Gateway process: mounts only the member JWT public key and signer socket.
DTX_MEMBER_JWT_PUBLIC_KEY_PATH=/run/secrets/member-jwt-public.pem
DTX_MEMBER_JWT_ISSUER=mcpdocs
# Set an audience after the neutral identity issuer adds aud to every token.
# DTX_MEMBER_JWT_AUDIENCE=dtx-tools
# Qualification LAN binding (workstation LAN IP: 192.168.20.100).
# Production should use a TLS reverse proxy and a trusted member issuer.
CCB_GATEWAY_HOST=0.0.0.0
CCB_GATEWAY_PORT=8787
CCB_GATEWAY_PUBLISH_PORT=8787
CCB_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.20.100

# Release-admin verification keys are public trust anchors only.
# Set the PEM values through the deployment secret manager; do not commit them.
CCB_RELEASE_TARGETS_KEY_ID=release-targets
# CCB_RELEASE_TARGETS_PUBLIC_KEY_PEM=
CCB_RELEASE_POLICY_KEY_ID=rollout-policy
# CCB_RELEASE_POLICY_PUBLIC_KEY_PEM=
CCB_RELEASE_TARGETS_THRESHOLD=1
CCB_RELEASE_POLICY_THRESHOLD=1
CCB_DB_PATH=/var/lib/cc-bridge/cc-bridge.db
CCB_EXECUTION_KEY_ID=execution-prod-1
CCB_SIGNER_SOCKET=/run/cc-bridge/signer.sock
CCB_IP_REQUESTS_PER_MINUTE=240
CCB_MEMBER_REQUESTS_PER_MINUTE=120
CCB_MAX_TRACKED_RATE_KEYS=10000
CCB_MAX_CONCURRENT_EXECUTE=64
CCB_MAX_QUEUED_EXECUTE=128
CCB_QUEUE_TIMEOUT_MS=1000

# Signer process only: do not provide this path to the Gateway process.
CCB_SIGNER_PRIVATE_KEY_PATH=/run/secrets/execution-private.pem
CCB_SIGNER_MAX_PER_SECOND=1000

# Development/test only. Production ignores in-process PKCS8 unless explicitly enabled.
# CCB_ALLOW_MEMORY_SIGNER=1
# CCB_EXECUTION_PRIVATE_KEY_PKCS8=
