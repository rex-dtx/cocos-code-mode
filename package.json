    "obfuscate:dist": "node ./scripts/obfuscate-dist.js",
    "rename:dist": "node ./scripts/rename-dist.js",
    "package": "npm run build:release && node ./scripts/obfuscate-dist.js && node ./scripts/rename-dist.js && node ./scripts/package.js",
