{
  "name": "cocos-code-mode-2x",
  "version": "1.0.0",
  "description": "i18n:cocos-code-mode-2x.description",
  "author": "cst by hzi for cc2.4",
  "main": "dist/main.js",
  "scene-script": "dist/scene-script.js",
  "main-menu": {
    "Extension/Cocos Code Mode 2x/Configuration": {
      "message": "cocos-code-mode-2x:open-config"
    },
    "Extension/Cocos Code Mode 2x/Server Info": {
      "message": "cocos-code-mode-2x:show-info"
    },
    "Extension/Cocos Code Mode 2x/Restart Server": {
      "message": "cocos-code-mode-2x:restart-server"
    },
    "Extension/Cocos Code Mode 2x/Reload Extension": {
      "message": "cocos-code-mode-2x:reload"
    },
    "Extension/Cocos Code Mode 2x/About": {
      "message": "cocos-code-mode-2x:show-build-info"
    }
  },
  "panel": {
    "main": "panel/configuration.js",
    "type": "dockable",
    "title": "Cocos Code Mode 2x",
    "width": 600,
    "height": 700,
    "min-width": 400,
    "min-height": 400
  },
  "reload": {
    "ignore": [
      "node_modules/**/*"
    ]
  },
  "scripts": {
    "build": "node ./scripts/generate-build-info.js && npx tsc",
    "check": "npm run build && node ./scripts/check-node-budget.js",
    "package": "npm run check && node ./scripts/package.js"
  },
  "dependencies": {
    "@types/sharp": "^0.31.1",
    "@utcp/http": "^1.1.0",
    "@utcp/sdk": "^1.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fs-extra": "^10.0.0",
    "sharp": "^0.30.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^9.0.5",
    "@types/node": "^14.18.63",
    "archiver": "^7.0.1",
    "typescript": "^5.8.2"
  }
}
