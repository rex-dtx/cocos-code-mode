  "description": "i18n:cc-bridge-2x.description",
  "author": "cst by hzi for cc2.4",
  "main": "dist/main.js",
  "scene-script": "dist/scene-script.js",
  "main-menu": {
    "CC Bridge 2x/Configuration": {
      "message": "cc-bridge-2x:open-config"
    },
    "CC Bridge 2x/Restart Server": {
      "message": "cc-bridge-2x:restart-server"
    },
    "CC Bridge 2x/Toggle Debug Logging": {
      "message": "cc-bridge-2x:toggle-debug"
    },
    "CC Bridge 2x/Debug Logs/Open Debug Folder": {
      "message": "cc-bridge-2x:open-debug-folder"
    },
    "CC Bridge 2x/Debug Logs/Clear Debug Logs": {
      "message": "cc-bridge-2x:clear-debug-logs"
    },
    "CC Bridge 2x/About": {
      "message": "cc-bridge-2x:show-build-info"
    },
    "Extension/CC Bridge 2x/Configuration": {
      "message": "cc-bridge-2x:open-config"
    },
    "Extension/CC Bridge 2x/Restart Server": {
      "message": "cc-bridge-2x:restart-server"
    },
    "Extension/CC Bridge 2x/Toggle Debug Logging": {
      "message": "cc-bridge-2x:toggle-debug"
    },
    "Extension/CC Bridge 2x/Debug Logs/Open Debug Folder": {
      "message": "cc-bridge-2x:open-debug-folder"
    },
    "Extension/CC Bridge 2x/Debug Logs/Clear Debug Logs": {
      "message": "cc-bridge-2x:clear-debug-logs"
    },
    "Extension/CC Bridge 2x/About": {
      "message": "cc-bridge-2x:show-build-info"
    }
  },
  "panel": {
    "main": "panel/configuration.js",
    "type": "dockable",
    "title": "CC Bridge 2x",
    "width": 600,
    "height": 700
  },
  "reload": {
    "ignore": [
      "node_modules/**/*"
    ]
  },
  "scripts": {
    "build": "node ./scripts/generate-build-info.js && npx tsc",
    "check": "npm run build && node ./scripts/check-node-budget.js && node ./scripts/compare-cross-version-parity.js && npm run test:graph",
    "package": "npm run check && node ./scripts/package.js",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:live": "node --test tests/live/*.test.js",
    "test:graph": "node --test tools/cocos-graph/tests/*.test.mjs",
    "test:all": "node --test tests/unit/*.test.js tests/live/*.test.js tools/cocos-graph/tests/*.test.mjs",
    "link:project": "node ./scripts/link-project-extension.js",
    "link:plans": "python ../../../_devtools/cfg-n-scripts/notes/08_System/mount_project_plans.py --here",
    "smoke:utcp": "node ./scripts/smoke-utcp.js",
    "smoke:execute-js": "node ./scripts/smoke-execute-js-full.js"
  },
  "dependencies": {
    "@types/sharp": "^0.31.1",
    "@utcp/http": "^1.1.0",
    "@utcp/sdk": "^1.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fs-extra": "^10.0.0",
    "sharp": "^0.30.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^9.0.5",
    "@types/node": "^14.18.63",
    "archiver": "^7.0.1",
    "typescript": "^5.8.2"
  }
}
