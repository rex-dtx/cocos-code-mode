# Protected relay qualification environment.
# LAN address detected for this workstation: 192.168.20.100.
# Do not commit real member credentials, private keys, or bearer tokens.

# Gateway local origin. The protected client intentionally permits insecure HTTP only on loopback.
# Production and LAN deployments must use HTTPS with a trusted certificate.
CCB_GATEWAY_ORIGIN=http://127.0.0.1:8787
CCB_ALLOW_INSECURE_GATEWAY=1
CCB_PROJECT_ID=replace-with-opaque-project-id
CCB_MEMBER_CREDENTIAL=replace-with-short-lived-eddsa-member-jwt
CCB_APPROVED_DEVICE_ID=replace-after-enrollment
CCB_APPROVED_DEVICE_KEY_ID=replace-after-enrollment
CCB_EXECUTION_KEY_ID=execution-dev-1
CCB_EXECUTION_PUBLIC_KEY=replace-with-base64url-ed25519-spki
CCB_DEVICE_LABEL=replace-with-human-readable-device-label
# Optional override; defaults to %USERPROFILE%\.cc-bridge\identity\device-identity-v1.json.
# CCB_DEVICE_IDENTITY_PATH=C:\path\to\device-identity-v1.json

# Signed release origin. Must be HTTPS and serve the complete immutable release set.
CCB_RELEASE_ORIGIN=https://192.168.20.100:8788/
CCB_RELEASE_HOST=192.168.20.100
CCB_RELEASE_PORT=8788
CCB_RELEASE_DIRECTORY=C:\ccb-release
CCB_RELEASE_TLS_CERT=C:\certs\192.168.20.100+2.pem
CCB_RELEASE_TLS_KEY=C:\certs\192.168.20.100+2-key.pem
CCB_RELEASE_CHANNEL=stable
CCB_RELEASE_ROOT_PATH=replace-with-local-root.json
CCB_RELEASE_ROOT_SHA256=replace-with-sha256-of-root-json-bytes

# Release assembly requires the signed root wrapper separately from the canonical root payload.
CCB_RELEASE_ROOT_METADATA_PATH=replace-with-signed-root-metadata-json
CCB_RELEASE_ZIP=replace-with-built-release-zip

# CCB_RELEASE_ROOT_PATH is the canonical unsigned root payload used for bootstrap pinning.
# CCB_RELEASE_ROOT_METADATA_PATH is the signed wrapper served by the release origin.
